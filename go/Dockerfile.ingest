FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/ingest ./cmd/ingest

# yara CLI is installed here (not the builder stage) so the ingest binary
# can shell out to it for the file-scanning detector (internal/detect/yara.go).
FROM alpine:3.20
RUN apk add --no-cache yara ca-certificates
COPY --from=builder /out/ingest /usr/local/bin/ingest
ENTRYPOINT ["/usr/local/bin/ingest"]
